# Text provider: Hermes uses your Codex login under the same Linux user.
AI_PROVIDER=hermes
HERMES_COMMAND=hermes
HERMES_TIMEOUT_SECONDS=600
# Only for alternative AI_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=

WP_URL=https://allaboutmoney.id
WP_USERNAME=
WP_APP_PASSWORD=
POST_STATUS=draft
INTERVAL_HOURS=12
ARTICLE_MIN_WORDS=700
ARTICLE_TARGET_WORDS=1100
# Paid OpenAI image API is off; enable only with separate API credits.
ENABLE_AI_IMAGE=false
INLINE_IMAGE=false
